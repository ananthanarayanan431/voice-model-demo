    "/api/v1/speech/{speech_id}": {
      "get": {
        "description": "Stream a reply's audio from Vartaloop as it is synthesised.",
        "operationId": "speech_audio_api_v1_speech__speech_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "speech_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{16,64}$",
              "title": "Speech Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "audio/ogg": {}
            },
            "description": "Ogg/Opus audio"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found, or an expired audio link"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
