# ---------------------------------------------------------------------------
# VoiceAgents - voice agent environment
#
# Copy to .env and fill in the keys:  make env
# Everything not listed here falls back to the default in voice_agent/config/
# ---------------------------------------------------------------------------

# --- Vartaloop TTS (speaks the assistant's replies) ---
# Create one at https://tts.vartaloop.ai (API keys). Sent as the x-api-key header.
# Without it the app still works; replies show as text only.
VARTALOOP_API_KEY=
VARTALOOP_VOICE=saanvi
# Longest reply one /api/v1/tts call will speak (caps what a call can bill).
VARTALOOP_MAX_CHARS=800

# --- Anthropic (required: every patient turn) ---
# Blank = the SDK's own credential lookup (ANTHROPIC_AUTH_TOKEN, `ant auth login`).
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Low keeps the pause before each spoken reply short.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60
# Tool round trips allowed in one patient turn (guards against loops).
MAX_TOOL_ROUNDS=6

# --- Application ---
PROJECT_NAME=VoiceAgents
APP_VERSION=0.1.0
# When set, every /api/v1 call must send it as the X-API-Key header.
API_KEY=
# Hospital time zone: "today" for bookings is a date in this zone.
TIMEZONE=Asia/Kolkata
# Extra browser origins allowed to call the API (comma separated). Not needed
# behind the Vite proxy or the nginx image, which serve the app and API together.
ADDITIONAL_CORS_ORIGINS=

# --- Server (run.sh / Docker) ---
HOST=0.0.0.0
PORT=8000
RELOAD=true
