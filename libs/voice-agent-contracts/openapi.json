{
  "components": {
    "schemas": {
      "AppointmentOut": {
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "doctor_name": {
            "title": "Doctor Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "patient_name": {
            "title": "Patient Name",
            "type": "string"
          },
          "specialty": {
            "title": "Specialty",
            "type": "string"
          },
          "start": {
            "format": "time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "doctor_name",
          "specialty",
          "day",
          "start",
          "patient_name"
        ],
        "title": "AppointmentOut",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_id": {
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "appointments": {
            "items": {
              "$ref": "#/components/schemas/AppointmentOut"
            },
            "title": "Appointments",
            "type": "array"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          }
        },
        "required": [
          "reply",
          "appointments"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "DoctorOut": {
        "properties": {
          "days": {
            "items": {
              "type": "string"
            },
            "title": "Days",
            "type": "array"
          },
          "hours": {
            "title": "Hours",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "specialty": {
            "title": "Specialty",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "specialty",
          "days",
          "hours"
        ],
        "title": "DoctorOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "llm_model": {
            "title": "Llm Model",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tts_configured": {
            "title": "Tts Configured",
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "tts_configured",
          "llm_model"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "ResetRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "VoiceAgents voice agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat": {
      "post": {
        "description": "One patient turn: the final transcript in, the assistant's reply out.",
        "operationId": "chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "voice"
        ]
      }
    },
    "/api/v1/chat/reset": {
      "post": {
        "description": "Forget a conversation (the \"New call\" button).",
        "operationId": "reset_api_v1_chat_reset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Reset",
        "tags": [
          "voice"
        ]
      }
    },
    "/api/v1/doctors": {
      "get": {
        "operationId": "doctors_api_v1_doctors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DoctorOut"
                  },
                  "title": "Response Doctors Api V1 Doctors Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Doctors",
        "tags": [
          "clinic"
        ]
      }
    },
    "/api/v1/tts": {
      "get": {
        "description": "Speak ``text`` with Vartaloop. A GET, so an <audio> element can play it as\nit streams; the key stays on the server.",
        "operationId": "tts_api_v1_tts_get",
        "parameters": [
          {
            "in": "query",
            "name": "text",
            "required": true,
            "schema": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "audio/ogg": {}
            },
            "description": "Ogg/Opus audio"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Tts",
        "tags": [
          "voice"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
