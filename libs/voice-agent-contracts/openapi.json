              }
            },
            "description": "A required key is not configured"
          }
        },
        "summary": "Speech Audio",
        "tags": [
          "voice"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_HealthStatus_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness, and which optional features are on (the web app reads this).",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_ReadyStatus_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
