              }
            },
            "description": "Unexpected error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Claude or Vartaloop failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A required key is not configured"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Reset",
        "tags": [
          "voice"
        ]
      }
    },
    "/api/v1/doctors": {
      "get": {
        "operationId": "doctors_api_v1_doctors_get",
        "responses": {
          "200": {
            "content": {
