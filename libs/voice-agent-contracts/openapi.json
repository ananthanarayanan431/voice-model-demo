{
  "components": {
    "schemas": {
      "AppointmentOut": {
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "doctor_name": {
            "title": "Doctor Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "patient_name": {
            "title": "Patient Name",
            "type": "string"
          },
          "specialty": {
            "title": "Specialty",
            "type": "string"
          },
          "start": {
            "format": "time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "doctor_name",
          "specialty",
          "day",
          "start",
          "patient_name"
        ],
        "title": "AppointmentOut",
        "type": "object"
      },
      "ChatReply": {
        "properties": {
          "appointments": {
            "description": "Booked during this turn",
            "items": {
              "$ref": "#/components/schemas/AppointmentOut"
            },
            "title": "Appointments",
            "type": "array"
          },
          "audio_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Short-lived link to the spoken reply; null when speech is off",
            "title": "Audio Url"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          }
        },
        "required": [
          "reply",
          "appointments",
          "audio_url"
        ],
        "title": "ChatReply",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_id": {
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "DoctorOut": {
        "properties": {
          "days": {
            "items": {
              "type": "string"
            },
            "title": "Days",
            "type": "array"
          },
          "hours": {
            "title": "Hours",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "specialty": {
            "title": "Specialty",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "specialty",
          "days",
          "hours"
        ],
        "title": "DoctorOut",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "description": "Stable machine-readable code, e.g. rate_limited",
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "description": "Human-readable, safe to show to a user",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": false,
            "default": false,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "description": "Dotted location of the invalid input, e.g. body.message",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "ReadyStatus": {
        "properties": {
          "llm_model": {
            "title": "Llm Model",
            "type": "string"
          },
          "speech_enabled": {
            "title": "Speech Enabled",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "speech_enabled",
          "llm_model"
        ],
        "title": "ReadyStatus",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "session_id": {
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "ResetRequest",
        "type": "object"
      },
      "ResetResult": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "ResetResult",
        "type": "object"
      },
      "SuccessResponse_ChatReply_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ChatReply"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SuccessResponse[ChatReply]",
        "type": "object"
      },
      "SuccessResponse_HealthStatus_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SuccessResponse[HealthStatus]",
        "type": "object"
      },
      "SuccessResponse_ReadyStatus_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReadyStatus"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SuccessResponse[ReadyStatus]",
        "type": "object"
      },
      "SuccessResponse_ResetResult_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ResetResult"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SuccessResponse[ResetResult]",
        "type": "object"
      },
      "SuccessResponse_list_DoctorOut__": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DoctorOut"
            },
            "title": "Data",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "title": "SuccessResponse[list[DoctorOut]]",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "VoiceAgents voice agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat": {
      "post": {
        "description": "One patient turn: the final transcript in, the assistant's reply out.",
        "operationId": "chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_ChatReply_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found, or an expired audio link"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Claude or Vartaloop failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A required key is not configured"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "voice"
        ]
      }
    },
